<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Opens Jarvis.app at login. -->
<plist version="1.0">
<dict>
	<key>Label</key><string>com.jarvis-tv.mac-app</string>
	<key>ProgramArguments</key>
	<array><string>/usr/bin/open</string><string>-a</string><string>__HOME__/Applications/Jarvis.app</string></array>
	<key>RunAtLoad</key><true/>
</dict>
</plist>
